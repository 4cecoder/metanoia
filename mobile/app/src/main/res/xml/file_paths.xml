<?xml version="1.0" encoding="utf-8"?>
<!-- Referenced by AndroidManifest.xml's FileProvider <meta-data>. Only
     exposes the specific cache subdirectory ApkInstaller downloads update
     APKs into — nothing else in the app's storage is reachable via this
     provider. -->
<paths>
    <cache-path name="apk_updates" path="apk-updates/" />
</paths>
