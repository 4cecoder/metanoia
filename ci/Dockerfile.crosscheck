ARG ZIG_VERSION=0.17.0-dev.1398+cb5635714

FROM debian:bookworm-slim AS base
ARG TARGETARCH
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
    curl xz-utils mingw-w64 pkg-config jq \
    libgtk-4-dev libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

FROM base AS zig
ARG ZIG_VERSION
ARG TARGETARCH
RUN ZIG_ARCH="$(if [ "$TARGETARCH" = "arm64" ]; then echo "aarch64"; else echo "x86_64"; fi)-linux" && \
    curl -fsSL "https://ziglang.org/builds/zig-${ZIG_ARCH}-${ZIG_VERSION}.tar.xz" \
    | tar xJ -C /opt && \
    ln -s "/opt/zig-${ZIG_ARCH}-${ZIG_VERSION}/zig" /usr/local/bin/zig

FROM zig
WORKDIR /workspace
COPY ci/crosscheck.sh /ci/crosscheck.sh
ENTRYPOINT ["/ci/crosscheck.sh"]
