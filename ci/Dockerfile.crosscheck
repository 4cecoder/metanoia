ARG ZIG_VERSION=0.17.0-dev.1398+cb5635714

FROM debian:bookworm-slim AS base
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
    curl xz-utils mingw-w64 pkg-config jq \
    libgtk-4-dev libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

FROM base AS zig
ARG ZIG_VERSION
RUN curl -fsSL "https://ziglang.org/builds/zig-x86_64-linux-${ZIG_VERSION}.tar.xz" \
    | tar xJ -C /opt
ENV PATH="/opt/zig-x86_64-linux-${ZIG_VERSION}:$PATH"

FROM zig
WORKDIR /workspace
COPY ci/crosscheck.sh /ci/crosscheck.sh
ENTRYPOINT ["/ci/crosscheck.sh"]
